## Provider selection
LLM_PROVIDER=openai
LLM_MODEL=

## OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

## Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

## Gemini
GEMINI_API_KEY=
